pipeline {
    agent any

    environment {
        IMAGE_NAME = "snake-game"
        CONTAINER_NAME = "snake-game-app"
        HOST_PORT = "8085"
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls source code from the connected Git repository
                checkout scm
            }
        }

        stage('Validate & Test') {
            steps {
                echo 'Checking project files...'
                sh '''
                    test -f index.html || { echo "Error: index.html missing!"; exit 1; }
                    echo "All required game files are present."
                '''
                // If you use Node.js/npm for linting or tests, uncomment below:
                // sh 'npm install && npm test'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image for Snake Game...'
                sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Deploy Container') {
            steps {
                echo 'Deploying updated Snake Game container...'
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker run -d --name ${CONTAINER_NAME} -p ${HOST_PORT}:80 ${IMAGE_NAME}:latest
                """
            }
        }
    }

    post {
        success {
            echo "Build #${BUILD_NUMBER} succeeded! Play the game at http://<your-server-ip>:${HOST_PORT}"
        }
        failure {
            echo "Build #${BUILD_NUMBER} failed. Check the Jenkins console logs."
        }
    }
}
